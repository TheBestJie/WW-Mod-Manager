Screen {
    background: $surface;
    color: $text;
}

#home-header {
    height: 3;
    padding: 0 1;
    border: round $primary;
    content-align: left middle;
}

#groups {
    height: 1fr;
    border: round $primary;
}

Footer {
    background: $panel;
}

HotkeysScreen {
    align: center middle;
}

#hotkeys-box {
    width: 90%;
    max-width: 120;
    height: 85%;
    border: round $primary;
    background: $surface;
    padding: 0 1;
}

#hotkeys-header {
    height: auto;
    padding-top: 1;
}

#hotkey-warning {
    color: $warning;
    padding-top: 1;
}

#hotkeys-scroll {
    height: 1fr;
    padding-top: 1;
}

#hotkeys {
    height: auto;
    border: none;
    padding: 0;
    background: $surface;
}

#hotkeys > .option-list--option-disabled {
    color: $accent;
    text-style: bold;
    padding-top: 1;
}

#hotkeys-hint {
    height: 1;
    color: $text-muted;
}

UpdateScreen,
SelfUpdateScreen,
HotkeyEditScreen {
    align: center middle;
}

/* A bare Vertical inside a ModalScreen defaults to 1fr, which stretched the
   dialog over the whole terminal and pinned its content to the top-left. */
#update-box,
#self-update-box,
#hotkey-edit-box {
    max-width: 94%;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#update-box {
    width: 56;
}

#self-update-box {
    width: 74;
}

#hotkey-edit-box {
    width: 76;
}

/* The button row defaults to 1fr height, which would stretch the auto-height
   dialog back to the full terminal height. */
#update-box > Horizontal,
#self-update-box > Horizontal {
    height: auto;
}
